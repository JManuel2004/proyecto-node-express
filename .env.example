# Configuración para MongoDB Atlas (Render deployment)
MONGO_URI=mongodb+srv://app_user:app_password_123@proyecto-backend.xxxxx.mongodb.net/proyecto_backend?retryWrites=true&w=majority

# JWT Secret Key (CAMBIAR en producción)
JWT_SECRET=mi_super_secreto_jwt_key_academico_2024

# Configuración del servidor
PORT=3000
NODE_ENV=production

# Rate Limiting (opcional, tiene valores por defecto)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Configuración de bcrypt
BCRYPT_SALT_ROUNDS=12